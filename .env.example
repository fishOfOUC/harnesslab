# HarnessLab 配置模板（复制为 .env 后按本机实际情况填写）
# 优先级：内置默认值 < configs/app.config.json < 环境变量
# 真实 .env 与密钥不得提交到版本库。

# ---- 运行环境 ----
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DEV_OWNER_ID=local-dev-user
LOG_LEVEL=INFO

# ---- 存储 ----
# DATA_DIR=data
# ARTIFACT_DIR=artifacts
# VECTOR_MODE=local
# 单机默认让 API 内联工作进程（Local 向量库只允许单进程访问）
RUN_WORKER_IN_API=true

# ---- Embedding（LM Studio；文档 04 第 3 节）----
EMBEDDING_PROVIDER=lm_studio
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=replace-with-real-embedding-model-id
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_NORMALIZE=true

# ---- Chat（独立于 Embedding 配置）----
# CHAT_PROVIDER 可选 openai_compatible | stub（stub 为替身，界面会标注）
CHAT_PROVIDER=openai_compatible
CHAT_BASE_URL=http://localhost:1234/v1
CHAT_MODEL=replace-with-real-chat-model-id
CHAT_API_KEY=
CHAT_CONTEXT_WINDOW=8192
ALLOW_CLOUD_FALLBACK=false
MODEL_MAX_CONCURRENCY=1

# ---- 检索 ----
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=8

# ---- 预算（文档 03 第 9 节）----
BUDGET_MAX_MODEL_CALLS=20
BUDGET_MAX_TOOL_CALLS=30
BUDGET_ACTIVE_TIMEOUT_SECONDS=180
BUDGET_TOOL_TIMEOUT_SECONDS=30

# ---- 审批与保留 ----
APPROVAL_TTL_HOURS=24
RUN_EVENT_RETENTION_DAYS=30

# ---- 开发故障注入（生产必须为空）----
FAULT_INJECTION=

# ---- 可选能力 ----
SANDBOX_ENABLED=false
TRACE_EXPORT_ENABLED=false
